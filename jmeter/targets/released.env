# The published matchbox-ch-elm image. Use this to measure a released build,
# or as the baseline you compare your local changes against.
TARGET_NAME=released
# Published port. Override with PORT=8081 if 8080 is busy.
PORT="${PORT:-8080}"
HOST="http://localhost:${PORT}/matchboxv3"
COMPOSE_PROFILE=released
METRICS=auto

# ch-elm 1.16.0 on matchbox 5.0.0-rc2. Images from 1.15.1-cibuild2 on are only
# published to ghcr.io; older ones are still in europe-west6-docker.pkg.dev.
CHELM_IMAGE=ghcr.io/ahdis/matchbox-ch-elm:1.16.0-cibuild.20261028103805-5.0.0-rc2
JAVA_OPTS="${JAVA_OPTS:--Xmx4g -Xms4g -XX:+UseG1GC}"
CPUS="${CPUS:-4}"
MEM_LIMIT="${MEM_LIMIT:-6g}"
