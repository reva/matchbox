# Matchbox built from this working tree, with CH ELM loaded.
# run.sh brings the container up and tears it down around the run.
TARGET_NAME=local
# Published port. Override with PORT=8081 if 8080 is busy.
PORT="${PORT:-8080}"
HOST="http://localhost:${PORT}/matchboxv3"
COMPOSE_PROFILE=local

# Actuator is exposed by matchbox's own application.yaml, so heap and CPU
# sampling works here.
METRICS=auto

# Container tuning. Change these, rerun the same scenario, compare history.csv.
JAVA_OPTS="-Xmx4g -Xms4g -XX:+UseG1GC"
CPUS=4
MEM_LIMIT=6g
