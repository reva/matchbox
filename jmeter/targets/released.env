# The published matchbox-ch-elm image. Use this to measure a released build,
# or as the baseline you compare your local changes against.
TARGET_NAME=released
# Published port. Override with PORT=8081 if 8080 is busy.
PORT="${PORT:-8080}"
HOST="http://localhost:${PORT}/matchboxv3"
COMPOSE_PROFILE=released
METRICS=auto

CHELM_IMAGE=europe-west6-docker.pkg.dev/ahdis-ch/ahdis/matchbox-ch-elm:1.15.1
JAVA_OPTS="-Xmx4g -Xms4g -XX:+UseG1GC"
CPUS=4
MEM_LIMIT=6g
