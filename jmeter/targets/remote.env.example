# Template for measuring a matchbox instance you did not start yourself.
#
# Copy to something ending in .private.env so it is never committed:
#   cp remote.env.example my-instance.private.env
#   ./run.sh --target targets/my-instance.private.env --scenario steady
#
# Read the "Measuring a real instance" section of readme.md before using this.
# A real instance is shared, probably serving real traffic, and you control
# neither its warmup state nor what else is hitting it.

TARGET_NAME=my-instance
HOST=https://matchbox.example.ch/matchboxv3

# No compose profile: run.sh will not start or stop anything.
COMPOSE_PROFILE=

# ---------------------------------------------------------------------------
# Mutual TLS
# ---------------------------------------------------------------------------
# Client certificate presented to the server. PKCS12 (.p12/.pfx) or JKS.
# Paths are resolved relative to the jmeter/ directory. Keep the files in
# jmeter/certs/, which is gitignored.
#
# Convert a PEM keypair to PKCS12 first:
#   openssl pkcs12 -export -inkey client.key -in client.crt \
#     -out certs/client.p12 -name client
#
CLIENT_CERT=certs/client.p12
CLIENT_CERT_PASSWORD=
CLIENT_CERT_TYPE=PKCS12

# If the server presents a certificate from a private CA, point at a truststore
# containing that CA. Without this the handshake fails with PKIX path errors.
# Build one from a PEM CA certificate:
#   keytool -importcert -noprompt -alias ca -file ca.pem \
#     -keystore certs/truststore.p12 -storetype PKCS12 -storepass changeit
#
CA_TRUSTSTORE=
CA_TRUSTSTORE_PASSWORD=
CA_TRUSTSTORE_TYPE=PKCS12

# ---------------------------------------------------------------------------
# Header auth, if the instance uses it instead of, or alongside, mTLS
# ---------------------------------------------------------------------------
# AUTH_HEADER_NAME=Authorization
# AUTH_HEADER_VALUE=Bearer eyJ...

# ---------------------------------------------------------------------------
# Safety
# ---------------------------------------------------------------------------
# /actuator is normally blocked on a real deployment. "auto" probes once and
# disables heap sampling if it is not reachable, rather than filling the run
# with failed samples. Set "off" to skip the probe entirely.
METRICS=auto

# Defaults for this target, overridden by --rate and --duration. Deliberately
# low: run.sh refuses to raise the rate against a non-localhost host unless you
# pass --i-know-this-is-a-real-instance.
RATE=1
DURATION=120
